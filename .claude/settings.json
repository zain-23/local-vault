{
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|Bash",
          "hooks": [
            {
              "type": "command",
              "command": "bash .claude/hooks/file-guard.sh"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "prettier --write"
            }
          ]
        }
      ],
      "Notification": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash .claude/hooks/desktop-notify.sh"
            }
          ]
        }
      ]
    }
  }
  