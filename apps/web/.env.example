# Base URL of the local-vault server API. Required for `pnpm build`.
VITE_API_URL=http://localhost:8080/api/v1

# Canonical public origin used for og:image / og:url / rel=canonical.
# Optional — defaults to https://app.localvault.dev. Set this on any deploy
# that serves a different public hostname. No trailing slash needed.
VITE_SITE_URL=https://example.com
